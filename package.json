{
  "name": "@aviaratech/ai-subagent",
  "version": "0.1.0",
  "private": false,
  "description": "Experimental cross-provider subagent MCP plugin (WIP, not production-ready)",
  "homepage": "https://github.com/aviaratech/ai-subagent#readme",
  "bugs": {
    "url": "https://github.com/aviaratech/ai-subagent/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviaratech/ai-subagent.git"
  },
  "bin": {
    "ai-subagent": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test": "npm run build && node --test dist/*.test.js",
    "format": "oxfmt src scripts package.json tsconfig.json tsconfig.build.json .github",
    "format:check": "oxfmt --check src scripts package.json tsconfig.json tsconfig.build.json .github",
    "lint": "oxlint src scripts",
    "safety:check": "node scripts/public-safety-check.mjs",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "telemetry-report": "node dist/cli.js telemetry-report",
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run bundle && npm run safety:check && npm run pack:smoke",
    "prepare": "npm run bundle"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-glob": "^3.3.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.27.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0"
}
